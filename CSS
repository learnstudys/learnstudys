.profile{
    display:flex;
    justify-content:center;
    margin-top:40px;
}

.profile img{
    width:130px;
    height:130px;
    border-radius:50%;
    border:4px solid #ffffff;
    object-fit:cover;
    box-shadow:0 0 25px rgba(255,255,255,.25);
}

.tagline{
    text-align:center;
    color:#bfbfbf;
    margin-top:10px;
    font-size:18px;
    letter-spacing:1px;
}
